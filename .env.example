# H5 开发使用 /api/* + Vite 代理规避当前服务的 CORS 限制；部署 H5 与 App 使用完整 HTTPS 地址。
# 该服务地址和响应码与 c-pc 的已验证配置保持一致；本地覆盖项只放在未提交的 .env 文件。
VITE_REAL_SERVICE_SUCCESS_CODE=1
VITE_REAL_SERVICE_LOGOUT_CODES=-200
VITE_REAL_SERVICE_MODAL_LOGOUT_CODES=-201
VITE_REAL_USER_BASE_URL=/api/user
VITE_REAL_USER_TARGET_URL=https://testhou.merchantsale.store/api/user
VITE_REAL_ORDER_BASE_URL=/api/order
VITE_REAL_ORDER_TARGET_URL=https://testhou.merchantsale.store/api/order
VITE_REAL_ADMIN_BASE_URL=/api/admin
VITE_REAL_ADMIN_TARGET_URL=https://testhou.merchantsale.store/api/admin
